# Local development only. Set a strong, unique password before deployment.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=taskflow
POSTGRES_PORT=5432

# Keep these credentials in sync with POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB above.
DATABASE_URL=postgresql://taskflow:change-this-local-password@localhost:5432/taskflow

# Seed the first administrator the first time the application starts.
# Existing accounts and passwords are never replaced by this seed.
ADMIN_NAME=Workspace Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-8-characters

# Keep the two CSRF names in sync if either one is changed.
SESSION_COOKIE_NAME=taskflow_session
CSRF_COOKIE_NAME=taskflow_csrf
NEXT_PUBLIC_CSRF_COOKIE_NAME=taskflow_csrf
SESSION_DAYS=2
PASSWORD_HASH_ROUNDS=12

DEFAULT_STATUSES=TODO:To do,IN_PROGRESS:In progress,COMPLETED:Completed
NEXT_PUBLIC_API_BASE_URL=/api

# Local uploads are stored under .uploads. In production, configure blob storage.
LOCAL_UPLOAD_DIRECTORY=.uploads
BLOB_READ_WRITE_TOKEN=
PENDING_UPLOAD_MINUTES=30

DUMMYJSON_BASE_URL=https://dummyjson.com
EXTERNAL_USERS_TIMEOUT_MS=8000
